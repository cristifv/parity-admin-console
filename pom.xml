<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>parity</groupId>
  <artifactId>parity-admin-console</artifactId>
  <version>0.1.0</version>
  <name>parity-admin-console</name>
  <description>parity-admin-console: admin-api and the admin console (ARCH §3.9, PLAN.md). Keycloak login, the audit log, tenants through parity-store, tenants as Keycloak organizations</description>

  <properties>
    <java.version>21</java.version>
    <!-- parity-contracts (a plain sibling directory until git): parity-store's schemas (copied into the
         jar: the console validates every request it writes) and the masking cases. -->
    <parity.contracts.dir>${project.basedir}/../parity-contracts</parity.contracts.dir>
    <!-- The realm as code (parity-deploy compose/keycloak, SAML-PLAN step 2) and parity-store's jar: the
         integration tests run the real ones. scripts/ci.sh checks both exist. -->
    <parity.realm.file>${project.basedir}/../parity-deploy/compose/keycloak/realm-parity.json</parity.realm.file>
    <parity.store.jar>${project.basedir}/../parity-store/target/parity-store-0.1.0.jar</parity.store.jar>
    <!-- parity-rs's jar (2026-11-03: it places new tenants), started by the integration tests. -->
    <parity.rs.jar>${project.basedir}/../parity-rs/target/parity-rs.jar</parity.rs.jar>
    <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
    <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
    <json-schema-validator.version>3.0.8</json-schema-validator.version>
    <!-- As parity-store (OSV, 2026-10-27): kafka-clients' lz4-java and snappy-java. -->
    <lz4-java.version>1.11.4</lz4-java.version>
    <snappy-java.version>1.1.10.9</snappy-java.version>
    <errorprone.version>2.50.0</errorprone.version>
    <parity-errorprone-checks.version>0.1.0</parity-errorprone-checks.version>
    <errorprone.flags>-XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/generated-(test-)?sources/.* -Xep:FutureReturnValueIgnored:ERROR -Xep:GuardedBy:ERROR -Xep:UnusedVariable:ERROR -Xep:MissingCasesInEnumSwitch:ERROR</errorprone.flags>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>${lz4-java.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial.snappy</groupId>
        <artifactId>snappy-java</artifactId>
        <version>${snappy-java.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The browser API (/api), the web shell, the management port. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- Keycloak's JWTs (OAuth2 resource server, Nimbus); the service account's signed-JWT client
         assertion uses the same Nimbus library. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Postgres through JdbcClient (explicit SQL, row-level security set per transaction), Flyway. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The Kafka request/reply client: the plain client, as parity-store and parity-billing (no listener
         container, so no error handler can log a record's value). -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
    </dependency>

    <dependency>
      <groupId>com.google.errorprone</groupId>
      <artifactId>error_prone_annotations</artifactId>
      <version>${errorprone.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-redpanda</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- As spring-boot-starter-parent: application*.yml filtered (@project.version@), the rest as is. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/application*.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>**/application*.yml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>contract-schemas</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/contracts</outputDirectory>
              <resources>
                <resource>
                  <directory>${parity.contracts.dir}</directory>
                  <includes>
                    <include>VERSION</include>
                    <include>schemas/store/store-requests.v1.json</include>
                    <include>schemas/store/store-replies.v1.json</include>
                    <include>schemas/tenant-routing/tenant-routing-requests.v1.json</include>
                    <include>masking/cases.v1.json</include>
                    <include>masking/billing.v1.json</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-processing,-serial</arg>
            <arg>-Werror</arg>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-Xplugin:ErrorProne ${errorprone.flags}</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${errorprone.version}</version>
            </path>
            <path>
              <groupId>parity</groupId>
              <artifactId>parity-errorprone-checks</artifactId>
              <version>${parity-errorprone-checks.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>-Xlint:all,-processing,-serial</arg>
                <arg>-Werror</arg>
                <arg>-XDcompilePolicy=simple</arg>
                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                <arg>--should-stop=ifError=FLOW</arg>
                <arg>-Xplugin:ErrorProne ${errorprone.flags} -Xep:NoSynchronized:OFF -Xep:NoDataInMessages:OFF -Xep:StringSplitter:OFF</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Djdk.tracePinnedThreads=short</argLine>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <systemPropertyVariables>
            <parity.contracts.dir>${parity.contracts.dir}</parity.contracts.dir>
          </systemPropertyVariables>
          <environmentVariables>
            <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <argLine>-Djdk.tracePinnedThreads=short</argLine>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <systemPropertyVariables>
            <console.jar>${project.build.directory}/${project.build.finalName}.jar</console.jar>
            <parity.contracts.dir>${parity.contracts.dir}</parity.contracts.dir>
            <parity.realm.file>${parity.realm.file}</parity.realm.file>
            <parity.store.jar>${parity.store.jar}</parity.store.jar>
            <parity.rs.jar>${parity.rs.jar}</parity.rs.jar>
          </systemPropertyVariables>
          <environmentVariables>
            <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
                <bannedDependencies>
                  <excludes>
                    <exclude>log4j:log4j</exclude>
                    <exclude>org.apache.logging.log4j:log4j-core</exclude>
                    <exclude>org.projectlombok:lombok</exclude>
                  </excludes>
                </bannedDependencies>
                <requireReleaseDeps>
                  <message>No snapshot dependencies.</message>
                </requireReleaseDeps>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <outputFormat>json</outputFormat>
          <outputName>bom</outputName>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>${license-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>licences</id>
            <phase>verify</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- Check every build: without it the goal skips when THIRD-PARTY.txt is newer than the pom,
               so a dependency changed through the parent's BOM would go unchecked. -->
          <force>true</force>
          <failOnMissing>true</failOnMissing>
          <failOnBlacklist>true</failOnBlacklist>
          <overrideUrl>file://${project.basedir}/src/license/override-THIRD-PARTY.properties</overrideUrl>
          <includedLicenses>
            <includedLicense>Apache-2.0</includedLicense>
            <includedLicense>MIT</includedLicense>
            <includedLicense>MIT-0</includedLicense>
            <includedLicense>BSD-2-Clause</includedLicense>
            <includedLicense>BSD-3-Clause</includedLicense>
            <includedLicense>EPL-1.0</includedLicense>
            <includedLicense>EPL-2.0</includedLicense>
            <includedLicense>EDL-1.0</includedLicense>
            <includedLicense>MPL-2.0</includedLicense>
            <includedLicense>CC0-1.0</includedLicense>
            <includedLicense>LGPL-2.1</includedLicense>
            <includedLicense>CDDL-1.0</includedLicense>
            <includedLicense>CDDL-1.1</includedLicense>
            <includedLicense>CDDL-GPL-CE</includedLicense>
            <includedLicense>GPL-2.0-CE</includedLicense>
          </includedLicenses>
          <licenseMerges>
            <licenseMerge>Apache-2.0|Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache 2.0|Apache License 2.0|The Apache License, Version 2.0|Apache License Version 2.0|Apache Software License - Version 2.0|Apache License, version 2.0</licenseMerge>
            <licenseMerge>MIT|The MIT License|MIT License|The MIT License (MIT)|MIT license</licenseMerge>
            <licenseMerge>BSD-2-Clause|BSD 2-Clause License|The BSD 2-Clause License</licenseMerge>
            <licenseMerge>BSD-3-Clause|BSD 3-Clause License|The BSD 3-Clause License|BSD-3-Clause License</licenseMerge>
            <licenseMerge>EDL-1.0|Eclipse Distribution License - v 1.0|EDL 1.0|Eclipse Distribution License v. 1.0</licenseMerge>
            <licenseMerge>EPL-1.0|Eclipse Public License 1.0|Eclipse Public License - v 1.0</licenseMerge>
            <licenseMerge>EPL-2.0|Eclipse Public License 2.0|Eclipse Public License v2.0|Eclipse Public License - v 2.0|EPL 2.0|Eclipse Public License - Version 2.0</licenseMerge>
            <licenseMerge>MPL-2.0|Mozilla Public License 2.0|Mozilla Public License Version 2.0</licenseMerge>
            <licenseMerge>CC0-1.0|Public Domain, per Creative Commons CC0|CC0 1.0 Universal</licenseMerge>
            <licenseMerge>LGPL-2.1|GNU Lesser General Public License, Version 2.1|LGPL 2.1|LGPL-2.1-only</licenseMerge>
            <licenseMerge>CDDL-1.0|COMMON DEVELOPMENT AND DISTRIBUTION LICENSE (CDDL) Version 1.0</licenseMerge>
            <licenseMerge>CDDL-1.1|CDDL 1.1</licenseMerge>
            <licenseMerge>CDDL-GPL-CE|CDDL + GPLv2 with classpath exception|CDDL/GPLv2+CE</licenseMerge>
            <licenseMerge>GPL-2.0-CE|GPL2 w/ CPE|GNU General Public License, version 2 with the GNU Classpath Exception</licenseMerge>
          </licenseMerges>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
